# Database
DATABASE_URL="file:./dev.db"

# NextAuth — use a mesma porta do `npm run dev`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth — https://console.cloud.google.com/
# Redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Steam Web API — https://steamcommunity.com/dev/apikey (Domain: localhost)
STEAM_API_KEY=""

# RAWG — https://rawg.io/apidocs
RAWG_API_KEY=""

# IsThereAnyDeal — https://isthereanydeal.com/apps/
ITAD_API_KEY=""
ITAD_COUNTRY="BR"

# GOG — opcional; vazio = client público Galaxy (Heroic)
GOG_CLIENT_ID=""
GOG_CLIENT_SECRET=""

# Epic — opcional; vazio = client público Legendary/Heroic
EPIC_CLIENT_ID=""
EPIC_CLIENT_SECRET=""
# EPIC_LOCALE="pt-BR"
# EPIC_COUNTRY="BR"

# Amazon Games — fluxo Nile/Heroic no app (colar URL). Variáveis LWA não são necessárias.
# AMAZON_CLIENT_ID=""
# AMAZON_CLIENT_SECRET=""
# AMAZON_REDIRECT_URI="http://localhost:3000/api/platforms/amazon/callback"
