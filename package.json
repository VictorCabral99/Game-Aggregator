{
  "name": "game-aggregator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:desktop": "npm run build -w @gagg/core && npm run dev -w @gagg/desktop",
    "build:desktop": "npm run build -w @gagg/core && npm run build -w @gagg/desktop",
    "typecheck": "npm run typecheck -w @gagg/desktop && npm run typecheck -w @gagg/core && npm run typecheck -w @gagg/providers-meta",
    "smoke:sidecars": "node tools/scripts/smoke-sidecars.mjs",
    "smoke:wishlist": "node tools/scripts/wishlist-smoke.ts"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next-auth": "^4.24.7",
    "@auth/prisma-adapter": "^2.4.0",
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.3"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.9",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "prisma": "^5.18.0"
  }
}
