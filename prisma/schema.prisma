generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String?
  image              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastRatingsSyncAt  DateTime?
  lastDealsSyncAt    DateTime?
  lastDailySyncAt    DateTime?

  accounts           Account[]
  sessions           Session[]
  gameLibraries      GameLibrary[]
  wishlistItems      WishlistItem[]
  platformAccounts   PlatformAccount[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlatformAccount {
  id                  String    @id @default(cuid())
  userId              String
  platform            String // steam, gog, epic, luna
  externalUserId      String
  displayName         String?
  accessToken         String?
  refreshToken        String?
  tokenExpiresAt      DateTime?
  metadata            String? // JSON
  linkedAt            DateTime  @default(now())
  lastLibrarySyncAt   DateTime?
  lastWishlistSyncAt  DateTime?
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model GameLibrary {
  id          String   @id @default(cuid())
  userId      String
  platform    String // steam, gog, epic, luna
  externalId  String
  gameData    String // JSON
  syncedAt    DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings GameRating[]

  @@unique([userId, platform, externalId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  platform    String // steam, gog, epic, luna
  externalId  String
  gameData    String // JSON
  syncedAt    DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals GameDeal[]

  @@unique([userId, platform, externalId])
}

model GameRating {
  id            String   @id @default(cuid())
  gameLibraryId String
  source        String // metacritic, rawg
  rating        Float?
  reviewCount   Int?
  url           String?
  lastUpdated   DateTime @default(now())

  gameLibrary GameLibrary @relation(fields: [gameLibraryId], references: [id], onDelete: Cascade)

  @@unique([gameLibraryId, source])
}

model GameDeal {
  id                String   @id @default(cuid())
  wishlistItemId    String
  source            String // itad, ggdeals
  externalId        String?
  currentPrice      Float?
  regularPrice      Float?
  currency          String?
  cut               Int?
  shopName          String?
  historicalLow     Float?
  historicalLowShop String?
  url               String?
  dealData          String?
  lastUpdated       DateTime @default(now())

  wishlistItem WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)

  @@unique([wishlistItemId, source])
}
